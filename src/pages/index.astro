---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);
---

<!doctype html>
<html lang="ru">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				padding: 2em 0 1em;
			}
			.hero h1 {
				margin-bottom: 0.4em;
			}
			.tagline {
				font-size: 1.25em;
				color: rgb(var(--gray));
				margin: 0;
			}
			section {
				margin: 2.5em 0;
			}
			section h2 {
				margin-bottom: 0.8em;
			}
			.topics {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
			}
			.topics li {
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				padding: 0.3em 0.8em;
				border-radius: 999px;
				font-size: 0.9em;
			}
			.digests {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.digests li {
				padding: 1.2em 0;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.digests li:last-child {
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.digests .title {
				color: rgb(var(--black));
				font-size: 1.3em;
				line-height: 1.2;
				margin: 0 0 0.3em;
				text-decoration: none;
				display: block;
			}
			.digests .title:hover {
				color: var(--accent);
			}
			.digests .date {
				color: rgb(var(--gray));
				font-size: 0.9em;
				margin: 0 0 0.5em;
			}
			.digests .summary {
				margin: 0 0 0.6em;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.tags li {
				color: rgb(var(--gray));
				font-size: 0.85em;
			}
			.tags li::before {
				content: "#";
				margin-right: 0.1em;
			}
			.all-link {
				display: inline-block;
				margin-top: 1.5em;
				font-weight: 700;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>AI Digest</h1>
				<p class="tagline">
					Автоматический дайджест новостей искусственного интеллекта, машинного обучения и
					больших языковых моделей. Новые выпуски появляются сами: от поиска тем до публикации.
				</p>
			</section>

			<section>
				<h2>О проекте</h2>
				<p>
					AI Digest собирает новости AI и превращает их в короткие обзоры. Пайплайн ищет темы,
					пишет статьи, генерирует обложки и публикует без ручного участия. Аудитория —
					разработчики и продуктовые менеджеры.
				</p>
				<p>Тематика выпусков:</p>
				<ul class="topics">
					<li>Большие языковые модели</li>
					<li>Инструменты для разработчиков</li>
					<li>Исследования в машинном обучении</li>
					<li>Железо для AI-вычислений</li>
				</ul>
			</section>

			<section>
				<h2>Свежие дайджесты</h2>
				<ul class="digests">
					{
						posts.map((post) => (
							<li>
								<a class="title" href={`/blog/${post.id}/`}>
									{post.data.title}
								</a>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
								<p class="summary">{post.data.description}</p>
								{post.data.tags.length > 0 && (
									<ul class="tags">
										{post.data.tags.map((tag) => (
											<li>{tag}</li>
										))}
									</ul>
								)}
							</li>
						))
					}
				</ul>
				<a class="all-link" href="/blog/">Все дайджесты →</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
